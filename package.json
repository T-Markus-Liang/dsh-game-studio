{
  "name": "dsh-game-studio",
  "version": "0.1.0",
  "description": "DSH Game Studio: AI-native Game Development Runtime for DeepSeek Harness. 可安装/卸载/升级的游戏开发插件 —— /game 子命令、动态 Agent Pool、引擎适配器（Unity/UE5/Godot）、Verifier + Quality Gate。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "assets/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "src/",
    "scripts/",
    "fixtures/"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --test test/*.test.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "game-development",
    "game-studio",
    "unity",
    "unreal",
    "godot",
    "orchestrator",
    "verifier"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Markus-Liang/dsh-game-studio.git"
  },
  "homepage": "https://github.com/T-Markus-Liang/dsh-game-studio",
  "bugs": {
    "url": "https://github.com/T-Markus-Liang/dsh-game-studio/issues"
  }
}